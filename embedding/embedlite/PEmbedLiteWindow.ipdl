include protocol PEmbedLiteApp;

include "ipc/nsGUIEventIPC.h";
include "mozilla/GfxMessageUtils.h";

using gfxSize from "gfxPoint.h";
using class mozilla::MultiTouchInput from "InputData.h";

namespace mozilla {
namespace embedlite {

struct EmbedLiteChromeHistoryData {
  nsCString location;
  nsString title;
};

struct EmbedLiteChromeTabRestoreData {
  uint64_t persistentId;
  EmbedLiteChromeHistoryData[] history;
  int32_t selectedHistoryIndex;
};

struct EmbedLiteChromeTabData {
  uint64_t id;
  uint64_t persistentId;
  uint64_t locationRevision;
  nsCString location;
  nsString title;
  bool loading;
  bool closing;
  bool discarded;
  bool canGoBack;
  bool canGoForward;
  int32_t progress;
  int64_t current;
  int64_t total;
};

struct EmbedLiteChromeSessionData {
  uint64_t revision;
  uint64_t selectedTabId;
  EmbedLiteChromeTabData[] tabs;
};

struct EmbedLiteChromeBeforeUnloadData {
  uint64_t requestId;
  uint64_t tabId;
  uint64_t persistentId;
  nsString title;
  nsString text;
  nsString leaveLabel;
  nsString stayLabel;
};

[NestedUpTo=inside_cpow] sync protocol PEmbedLiteWindow {
  manager PEmbedLiteApp;

child:
  async SetSize(gfxSize aSize);
  async SetContentOrientation(uint32_t aRotation);
  async LoadURL(nsCString aURL, bool aFromExternal);
  async GoBack(bool aRequireUserInteraction, bool aUserActivation);
  async GoForward(bool aRequireUserInteraction, bool aUserActivation);
  async StopLoad();
  async Reload(bool aHardReload);
  async RestoreTabs(EmbedLiteChromeTabRestoreData[] aTabs,
                    int32_t aSelectedTabIndex);
  async NewTab(nsCString aURL, uint64_t aPersistentId, bool aFromExternal,
               bool aInBackground);
  async AssociateTab(uint64_t aTabId, uint64_t aPersistentId);
  async SelectTab(uint64_t aTabId);
  async CloseTab(uint64_t aTabId);
  async ResolveBeforeUnloadPrompt(uint64_t aRequestId, uint64_t aTabId,
                                  bool aPermit);
  async SetActive(bool aActive);
  async SetFocused(bool aFocused);
  async ReceiveInputEvent(MultiTouchInput aEvent);
  async Destroy();

parent:
  async Initialized(bool success);
  async OnLocationChanged(nsCString aLocation, bool aCanGoBack,
                          bool aCanGoForward);
  async OnLoadStarted(nsCString aLocation);
  async OnLoadFinished();
  async OnLoadProgress(int32_t aProgress, int64_t aCurrent, int64_t aTotal);
  async OnTitleChanged(nsString aTitle);
  async OnTabSnapshot(EmbedLiteChromeSessionData aSnapshot);
  async OnBeforeUnloadPrompt(EmbedLiteChromeBeforeUnloadData aPrompt);
  async Destroyed();
  async __delete__();
};

} // namespace embedlite
} // namespace mozilla
