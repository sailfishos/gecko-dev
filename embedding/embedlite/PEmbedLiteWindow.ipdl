include protocol PEmbedLiteApp;

include "mozilla/GfxMessageUtils.h";

using gfxSize from "gfxPoint.h";

namespace mozilla {
namespace embedlite {

[NestedUpTo=inside_cpow] sync protocol PEmbedLiteWindow {
  manager PEmbedLiteApp;

child:
  async SetSize(gfxSize aSize);
  async SetContentOrientation(uint32_t aRotation);
  async LoadURL(nsCString aURL, bool aFromExternal);
  async GoBack(bool aRequireUserInteraction, bool aUserActivation);
  async GoForward(bool aRequireUserInteraction, bool aUserActivation);
  async StopLoad();
  async Reload(bool aHardReload);
  async SetActive(bool aActive);
  async SetFocused(bool aFocused);
  async Destroy();

parent:
  async Initialized(bool success);
  async OnLocationChanged(nsCString aLocation, bool aCanGoBack,
                          bool aCanGoForward);
  async OnLoadStarted(nsCString aLocation);
  async OnLoadFinished();
  async OnLoadProgress(int32_t aProgress, int64_t aCurrent, int64_t aTotal);
  async OnTitleChanged(nsString aTitle);
  async Destroyed();
  async __delete__();
};

} // namespace embedlite
} // namespace mozilla
