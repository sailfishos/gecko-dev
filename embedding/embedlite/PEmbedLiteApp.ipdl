include protocol PCompositorBridge;
include protocol PEmbedLiteView;
include protocol PEmbedLiteWindow;

include DOMTypes;
include PrefsTypes;
include PBackgroundSharedTypes;
include URIParams;
include WindowGlobalTypes;

include "mozilla/dom/PermissionMessageUtils.h";
include "mozilla/dom/PolicyContainerMessageUtils.h";
include "mozilla/ipc/URIUtils.h";

using nsILoadInfo::CrossOriginEmbedderPolicy from "nsILoadInfo.h";
using mozilla::OriginAttributes from "mozilla/ipc/BackgroundUtils.h";

namespace mozilla {
namespace embedlite {

struct EmbedLiteOpenWindowInfoData
{
  uint64_t parentBrowsingContextId;
  bool forceNoOpener;
  bool isRemote;
  bool isForPrinting;
  bool isForWindowDotPrint;
  bool isTopLevelCreatedByWebContent;
  bool hasValidUserGestureActivation;
  bool textDirectiveUserActivation;
  OriginAttributes originAttributes;
  nullable nsIPrincipal principal;
  nullable nsIPrincipal partitionedPrincipal;
  nullable nsIURI baseURI;
  PolicyContainerArgs? policyContainer;
  CrossOriginEmbedderPolicy? coep;
};

struct EmbedLiteBrowserInitData
{
  WindowGlobalInit initialWindowGlobal;
  EmbedLiteOpenWindowInfoData openWindowInfo;
  uint32_t chromeFlags;
};

[NestedUpTo=inside_cpow, ChildProc=anydom] sync protocol PEmbedLiteApp {
  manages PEmbedLiteView;
  manages PEmbedLiteWindow;
parent:
  async Initialized();
  async ReadyToShutdown();
  sync CreateWindow(uint32_t parentId, EmbedLiteBrowserInitData browserInit,
                    uint32_t chromeFlags, bool hidden)
    returns (uint32_t createdID, bool cancel);
  async PrefsArrayInitialized(Pref[] prefs);

child:
  async PEmbedLiteView(uint32_t windowId, uint32_t id, uint32_t parentId,
                        bool isPrivateWindow, bool isDesktopMode,
                        bool isHidden, EmbedLiteBrowserInitData? browserInit);
  async PEmbedLiteWindow(uint16_t width, uint16_t height, uint32_t id,
                         uintptr_t listener, bool chromeHosted,
                         nsCString initialContentURI);
  async PreDestroy();
  async SetBoolPref(nsCString name, bool value);
  async SetCharPref(nsCString name, nsCString value);
  async SetIntPref(nsCString name, int value);
  async LoadGlobalStyleSheet(nsCString uri, bool aEnable);
  async AddObserver(nsCString topic);
  async RemoveObserver(nsCString topic);
  async LoadComponentManifest(nsCString manifest);
  async AddObservers(nsCString [] observers);
  async RemoveObservers(nsCString [] observers);
both:
  async Observe(nsCString topic, nsString data);
};

}}
