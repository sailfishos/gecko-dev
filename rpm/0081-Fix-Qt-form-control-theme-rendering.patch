+#ifdef MOZ_WIDGET_QT
+static constexpr CSSCoord kQtCheckboxRadioBorderBoxSize = 14.0f;
+static constexpr sRGBColor sQtControlBackground(
+    sRGBColor(1.0f, 1.0f, 1.0f));
+static constexpr sRGBColor sQtControlActiveBackground(
+    sRGBColor(0.94f, 0.94f, 0.94f));
+static constexpr sRGBColor sQtControlDisabledBackground(
+    sRGBColor(0.88f, 0.88f, 0.88f));
+static constexpr sRGBColor sQtControlBorder(
+    sRGBColor(0.73f, 0.73f, 0.73f));
+static constexpr sRGBColor sQtControlCheck(sRGBColor(0.19f, 0.21f, 0.23f));
+
+static const sRGBColor& QtControlBackgroundColor(const ElementState& aState) {
+  if (aState.HasState(ElementState::DISABLED)) {
+    return sQtControlDisabledBackground;
+  }
+  if (aState.HasState(ElementState::ACTIVE)) {
+    return sQtControlActiveBackground;
+  }
+  return sQtControlBackground;
+}
+
+template <typename PaintBackendData>
+static void PaintQtCircle(PaintBackendData& aPaintData,
+                          const LayoutDeviceRect& aRect,
+                          const sRGBColor& aColor) {
+  if (aColor.a == 0.0f || aRect.IsEmpty()) {
+    return;
+  }
+
+  const auto diameter = std::min(aRect.width, aRect.height);
+  const auto radius = diameter * 0.5f;
+  const auto center = aRect.Center();
+  const int rows =
+      std::max(1, std::min(64, int(std::ceil(float(diameter)))));
+  const float rowHeight = float(diameter) / rows;
+  const float top = float(center.y - radius);
+
+  for (int i = 0; i < rows; i++) {
+    const float y = top + rowHeight * i;
+    const float yMid = y + rowHeight * 0.5f;
+    const float dy = yMid - float(center.y);
+    const float halfWidth =
+        std::sqrt(std::max(0.0f, float(radius * radius) - dy * dy));
+    ThemeDrawing::FillRect(
+        aPaintData,
+        LayoutDeviceRect(LayoutDevicePoint(center.x - halfWidth, y),
+                         LayoutDeviceSize(halfWidth * 2.0f, rowHeight)),
+        aColor);
+  }
+}
+
+template <typename PaintBackendData>
+static void PaintQtCheckMark(PaintBackendData& aPaintData,
+                             const LayoutDeviceRect& aRect,
+                             const sRGBColor& aColor) {
+  const float checkPixels[][2] = {{-4.0f, 0.0f}, {-3.0f, 1.0f},
+                                  {-2.0f, 2.0f}, {-1.0f, 3.0f},
+                                  {0.0f, 3.0f},  {1.0f, 2.0f},
+                                  {2.0f, 1.0f},  {3.0f, 0.0f},
+                                  {4.0f, -1.0f}, {5.0f, -2.0f}};
+  const float scale =
+      ThemeDrawing::ScaleToFillRect(aRect, kQtCheckboxRadioBorderBoxSize);
+  const LayoutDeviceSize pixelSize(std::max(1.0f, scale * 2.0f),
+                                   std::max(1.0f, scale * 2.0f));
+  const auto center = aRect.Center();
+
+  for (const auto& point : checkPixels) {
+    LayoutDevicePoint position(
+        center.x + point[0] * scale - pixelSize.width * 0.5f,
+        center.y + point[1] * scale - pixelSize.height * 0.5f);
+    ThemeDrawing::FillRect(aPaintData, LayoutDeviceRect(position, pixelSize),
+                           aColor);
+  }
+}
+
+template <typename PaintBackendData>
+static void PaintQtIndeterminateMark(PaintBackendData& aPaintData,
+                                     const LayoutDeviceRect& aRect,
+                                     const sRGBColor& aColor) {
+  const float scale =
+      ThemeDrawing::ScaleToFillRect(aRect, kQtCheckboxRadioBorderBoxSize);
+  LayoutDeviceRect rect = aRect;
+  rect.y += (rect.height / 2) - (2.0f * scale / 2);
+  rect.height = 2.0f * scale;
+  rect.x += 2.0f * scale + (2.0f * scale / 8);
+  rect.width -= (2.0f * scale + (2.0f * scale / 8)) * 2;
+  ThemeDrawing::FillRect(aPaintData, rect, aColor);
+}
+
+template <typename PaintBackendData>
+static void PaintQtCheckbox(PaintBackendData& aPaintData,
+                            const LayoutDeviceRect& aRect,
+                            const ElementState& aState,
+                            CSSToLayoutDeviceScale aDpiRatio) {
+  const auto borderWidth =
+      LayoutDeviceCoord(ThemeDrawing::SnapBorderWidth(
+          kCheckboxRadioBorderWidth, aDpiRatio));
+  ThemeDrawing::FillRect(aPaintData, aRect, sQtControlBorder);
+  LayoutDeviceRect inner = aRect;
+  inner.Deflate(borderWidth);
+  ThemeDrawing::FillRect(aPaintData, inner, QtControlBackgroundColor(aState));
+
+  if (aState.HasState(ElementState::INDETERMINATE)) {
+    PaintQtIndeterminateMark(aPaintData, aRect, sQtControlCheck);
+  } else if (aState.HasState(ElementState::CHECKED)) {
+    PaintQtCheckMark(aPaintData, aRect, sQtControlCheck);
+  }
+}
+
+template <typename PaintBackendData>
+static void PaintQtRadio(PaintBackendData& aPaintData,
+                         const LayoutDeviceRect& aRect,
+                         const ElementState& aState,
+                         CSSToLayoutDeviceScale aDpiRatio) {
+  const auto borderWidth =
+      LayoutDeviceCoord(ThemeDrawing::SnapBorderWidth(
+          kCheckboxRadioBorderWidth, aDpiRatio));
+  PaintQtCircle(aPaintData, aRect, sQtControlBorder);
+
+  LayoutDeviceRect inner = aRect;
+  inner.Deflate(borderWidth);
+  PaintQtCircle(aPaintData, inner, QtControlBackgroundColor(aState));
+
+  if (aState.HasState(ElementState::CHECKED)) {
+    LayoutDeviceRect dot = aRect;
+    dot.Deflate(LayoutDeviceCoord(std::max(float(borderWidth * 2.0f),
+                                           float(aRect.width * 0.3f))));
+    PaintQtCircle(aPaintData, dot, sQtControlCheck);
+  }
+}
+#endif
