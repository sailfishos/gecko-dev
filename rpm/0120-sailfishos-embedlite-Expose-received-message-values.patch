From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Branson <andrew.branson@jolla.com>
Date: Mon, 24 Aug 2026 10:11:37 +0200
Subject: [sailfishos][embedlite] Expose received message values

Allow an opt-in message-manager callback to consume the already-deserialized
JS value after leaf and parent listeners have run. Report whether the
original clone contained transferables so JSON-only bridges can decline the
projection without reading or rewriting the holder.
---
 dom/base/MessageManagerCallback.h  |  9 +++++++++
 dom/base/nsFrameMessageManager.cpp | 18 +++++++++++++++++-
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/dom/base/MessageManagerCallback.h b/dom/base/MessageManagerCallback.h
index 0f60a32ec5fb..d8986740c8aa 100644
--- a/dom/base/MessageManagerCallback.h
+++ b/dom/base/MessageManagerCallback.h
@@ -5,6 +5,8 @@
 #ifndef dom_base_MessageManagerCallback_h_
 #define dom_base_MessageManagerCallback_h_
 
+#include "js/RootingAPI.h"
+#include "js/Value.h"
 #include "mozilla/NotNull.h"
 #include "mozilla/RefPtr.h"
 #include "nsError.h"
@@ -45,6 +47,13 @@ class MessageManagerCallback {
     return NS_OK;
   }
 
+  virtual bool WantsMessageReceived() const { return false; }
+
+  virtual void DoReceiveMessage(
+      JSContext* aCx, const nsAString& aMessage, bool aIsSync,
+      JS::Handle<JS::Value> aData, bool aHasTransferables,
+      nsTArray<NotNull<RefPtr<ipc::StructuredCloneData>>>* aRetVal) {}
+
   virtual mozilla::dom::ProcessMessageManager* GetProcessMessageManager()
       const {
     return nullptr;
diff --git a/dom/base/nsFrameMessageManager.cpp b/dom/base/nsFrameMessageManager.cpp
index fd1f63086173..dd1cd10b80cc 100644
--- a/dom/base/nsFrameMessageManager.cpp
+++ b/dom/base/nsFrameMessageManager.cpp
@@ -552,6 +552,18 @@ void nsFrameMessageManager::ReceiveMessage(
   argument.mTarget = aTarget;
   argument.mTargetFrameLoader = aTargetFrameLoader;
 
+  const bool notifyCallback = mCallback && mCallback->WantsMessageReceived();
+  bool hasTransferables = false;
+  if (notifyCallback && aCloneData->HasData() &&
+      aCloneData->SupportsTransferring() &&
+      !JS_StructuredCloneHasTransferables(aCloneData->BufferData(),
+                                          &hasTransferables)) {
+    NS_WARNING("Inspecting nsFrameMessageManager transferables failed");
+    hasTransferables = true;
+  }
+
+  JS::Rooted<JS::Value> data(RootingCx(), JS::NullValue());
+
   // Initialize the argument.{mData, mJson, mPorts} members.
   if (aCloneData->HasData()) {
     // aCloneData may contain transferrables (which can only be received once),
@@ -560,7 +572,6 @@ void nsFrameMessageManager::ReceiveMessage(
     // listeners are system code.
 
     ErrorResult error;
-    JS::Rooted<JS::Value> data(RootingCx(), JS::NullValue());
     aCloneData->Read(cx, &data, error);
     if (error.MaybeSetPendingException(cx)) {
       NS_WARNING("Deserializing nsFrameMessageManager message failed");
@@ -645,6 +656,11 @@ void nsFrameMessageManager::ReceiveMessage(
       }
     }
   }
+
+  if (notifyCallback && mCallback && mCallback->WantsMessageReceived()) {
+    mCallback->DoReceiveMessage(cx, aMessage, aIsSync, data,
+                                hasTransferables, aRetVal);
+  }
 }
 
 void nsFrameMessageManager::LoadPendingScripts(
