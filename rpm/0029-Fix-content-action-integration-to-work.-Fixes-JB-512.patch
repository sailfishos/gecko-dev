                 libs.extend(package.libs)
@@ -639,6 +642,8 @@ with only_when(toolkit_qt):
     set_define("MOZ_ENABLE_QMSYSTEM2", True, when=qmsystem2)
     set_config("MOZ_ENABLE_QT5FEEDBACK", True, when=qt_feedback)
     set_define("MOZ_ENABLE_QT5FEEDBACK", True, when=qt_feedback)
