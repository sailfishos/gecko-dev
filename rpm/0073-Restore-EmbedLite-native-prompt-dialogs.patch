From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Branson <andrew.branson@jolla.com>
Date: Mon, 4 May 2026 08:05:00 +0200
Subject: [PATCH 68/68] Restore EmbedLite native prompt dialogs

Route synchronous alert, confirm and prompt calls through the EmbedLite
application-service message bridge before falling back to the upstream
commonDialog.xhtml window prompt.

The Sailfish WebView popup layer still listens for embed:alert,
embed:confirm and embed:prompt and responds with the corresponding
*response messages.  ESR115's default prompt service bypassed that bridge
and tried to create a Gecko chrome dialog window instead, which is not the
native Sailfish UI path and can deadlock the EmbedLite window creation path.

The same bridge also handles username/password auth prompts through the
existing embed:auth dialog.  LoginManagerPrompter uses the async promptAuth
entry point for HTTP auth, so route async promptUserAndPass and
promptPassword requests through EmbedLite too, preserving the remember-login
checkbox state for the password manager.
---
 toolkit/components/prompts/src/Prompter.sys.mjs | 342 +++++++++++++++++++++++-
 1 file changed, 328 insertions(+), 14 deletions(-)

diff --git a/toolkit/components/prompts/src/Prompter.sys.mjs b/toolkit/components/prompts/src/Prompter.sys.mjs
index fe4499237824..b054a849e3c6 100644
--- a/toolkit/components/prompts/src/Prompter.sys.mjs
+++ b/toolkit/components/prompts/src/Prompter.sys.mjs
@@ -17,6 +17,57 @@ const {
 const COMMON_DIALOG = "chrome://global/content/commonDialog.xhtml";
 const SELECT_DIALOG = "chrome://global/content/selectDialog.xhtml";
 
+function dispatchAsyncAuthPrompt(callback, context, authInfo, runPrompt) {
+  let completed = false;
+
+  let cancelable = {
+    QueryInterface: ChromeUtils.generateQI(["nsICancelable"]),
+
+    cancel() {
+      if (completed) {
+        return;
+      }
+
+      completed = true;
+      try {
+        callback.onAuthCancelled(context, false);
+      } catch (e) {}
+    },
+  };
+
+  // nsIAuthPrompt2 requires that the callback is not invoked before
+  // asyncPromptAuth returns.
+  Services.tm.dispatchToMainThread(async () => {
+    if (completed) {
+      return;
+    }
+
+    let ok = false;
+    let promptFailed = false;
+    try {
+      ok = await runPrompt();
+    } catch (e) {
+      promptFailed = true;
+      console.error("Prompter: asyncPromptAuth failed: ", e);
+    }
+
+    if (completed) {
+      return;
+    }
+
+    completed = true;
+    try {
+      if (ok) {
+        callback.onAuthAvailable(context, authInfo);
+      } else {
+        callback.onAuthCancelled(context, !promptFailed);
+      }
+    } catch (e) {}
+  });
+
+  return cancelable;
+}
+
 export function Prompter() {
   // Note that EmbedPrompter clones this implementation.
 }
@@ -1022,11 +1073,228 @@ class ModalPrompter {
 
   /* ---------- internal methods ---------- */
 
+  openEmbedLitePromptSync(args) {
+    if (!this.browsingContext) {
+      return false;
+    }
+
+    let topic;
+    let responseTopic;
+
+    switch (args.promptType) {
+      case "alert":
+      case "alertCheck":
+        topic = "embed:alert";
+        responseTopic = "alertresponse";
+        break;
+      case "confirm":
+      case "confirmCheck":
+        topic = "embed:confirm";
+        responseTopic = "confirmresponse";
+        break;
+      case "prompt":
+        topic = "embed:prompt";
+        responseTopic = "promptresponse";
+        break;
+      case "promptUserAndPass":
+      case "promptPassword":
+        topic = "embed:auth";
+        responseTopic = "authresponse";
+        break;
+      default:
+        return false;
+    }
+
+    let embedService;
+    try {
+      embedService = Cc["@mozilla.org/embedlite-app-service;1"].getService(
+        Ci.nsIEmbedAppService
+      );
+    } catch (e) {
+      return false;
+    }
+
+    let win;
+    try {
+      win = this.browsingContext.top?.window || this.browsingContext.window;
+    } catch (e) {
+      return false;
+    }
+
+    if (!win) {
+      return false;
+    }
+
+    let winId;
+    try {
+      winId = embedService.getIDByWindow(win);
+    } catch (e) {
+      return false;
+    }
+
+    if (!winId) {
+      return false;
+    }
+
+    let payload = {
+      winId,
+      title: args.title,
+      text: args.text,
+      inputs: [],
+    };
+
+    if (args.button0Label || args.button1Label || args.button2Label) {
+      payload.buttons = [
+        args.button0Label,
+        args.button1Label,
+        args.button2Label,
+      ].filter(Boolean);
+    }
+
+    if (args.promptType == "prompt") {
+      payload.defaultValue = args.value || "";
+      payload.inputs.push({ value: args.value || "" });
+    }
+
+    if (args.promptType == "promptUserAndPass") {
+      payload.inputs.push({
+        type: "textbox",
+        value: args.user || "",
+        hint: "username",
+        autofocus: true,
+      });
+      payload.inputs.push({
+        type: "password",
+        value: args.pass || "",
+        hint: "password",
+        autofocus: false,
+      });
+    } else if (args.promptType == "promptPassword") {
+      payload.inputs.push({
+        type: "password",
+        value: args.pass || "",
+        hint: "password",
+        autofocus: true,
+      });
+    }
+
+    if (args.checkLabel) {
+      let isAuthPrompt =
+        args.promptType == "promptUserAndPass" ||
+        args.promptType == "promptPassword";
+      payload.inputs.push({
+        label: args.checkLabel,
+        hint: isAuthPrompt ? "remember" : "preventAddionalDialog",
+        checked: !!args.checked,
+      });
+    }
+
+    let closed = false;
+    let handleResponse = response => {
+      if (closed) {
+        return;
+      }
+
+      if ("checkvalue" in response) {
+        args.checked = !!response.checkvalue;
+      }
+      if ("accepted" in response) {
+        args.ok = !!response.accepted;
+        args.buttonNumClicked = response.accepted ? 0 : 1;
+      }
+      if ("promptvalue" in response) {
+        args.value = response.promptvalue;
+      }
+      if ("username" in response) {
+        args.user = response.username;
+      }
+      if ("password" in response) {
+        args.pass = response.password;
+      }
+      if ("remember" in response) {
+        args.checked = !!response.remember;
+      }
+
+      closed = true;
+    };
+    let appServiceListener = {
+      QueryInterface: ChromeUtils.generateQI(["nsIEmbedMessageListener"]),
+
+      onMessageReceived(messageName, message) {
+        try {
+          handleResponse(JSON.parse(message));
+        } catch (e) {
+          console.warn("EmbedLite prompt response parsing failed: ", e);
+        }
+      },
+    };
+
+    let promptWindow;
+    try {
+      promptWindow = this.browsingContext.window;
+    } catch (e) {
+      promptWindow = null;
+    }
+    let windowUtils;
+    let firedDialogEvent = false;
+    if (promptWindow) {
+      try {
+        let docShell = this.browsingContext.docShell;
+        let inPermitUnload = docShell?.contentViewer?.inPermitUnload;
+        args.inPermitUnload = inPermitUnload;
+        PromptUtils.fireDialogEvent(
+          promptWindow,
+          "DOMWillOpenModalDialog",
+          null,
+          Cu.cloneInto(
+            {
+              tabPrompt: this.modalType != MODAL_TYPE_WINDOW,
+              inPermitUnload,
+            },
+            promptWindow
+          )
+        );
+        firedDialogEvent = true;
+        windowUtils = promptWindow.windowUtils;
+        windowUtils?.enterModalState();
+      } catch (e) {
+        console.warn("EmbedLite prompt modal setup failed: ", e);
+      }
+    }
+
+    embedService.addMessageListener(responseTopic, appServiceListener);
+    try {
+      embedService.sendAsyncMessage(winId, topic, JSON.stringify(payload));
+      Services.tm.spinEventLoopUntilOrQuit(
+        "prompts/Prompter.sys.mjs:openEmbedLitePromptSync",
+        () => closed
+      );
+    } catch (e) {
+      return false;
+    } finally {
+      embedService.removeMessageListener(responseTopic, appServiceListener);
+      try {
+        windowUtils?.leaveModalState();
+        if (firedDialogEvent) {
+          PromptUtils.fireDialogEvent(promptWindow, "DOMModalDialogClosed");
+        }
+      } catch (e) {
+        console.warn("EmbedLite prompt modal cleanup failed: ", e);
+      }
+    }
+
+    return closed;
+  }
+
   /**
    * Synchronous wrapper around {@link ModalPrompter#openPrompt}
    * @param {Object} args Prompt arguments. When prompt has been closed, they are updated to reflect the result state.
    */
   openPromptSync(args) {
+    if (this.openEmbedLitePromptSync(args)) {
+      return;
+    }
+
     let closed = false;
     this.openPrompt(args)
       .then(returnedArgs => {
@@ -1046,6 +1314,10 @@ class ModalPrompter {
