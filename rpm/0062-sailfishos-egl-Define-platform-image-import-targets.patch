diff --git a/gfx/gl/SharedSurfaceEGL.cpp b/gfx/gl/SharedSurfaceEGL.cpp
index 9abce8748eca..2fb27052823a 100644
--- a/gfx/gl/SharedSurfaceEGL.cpp
