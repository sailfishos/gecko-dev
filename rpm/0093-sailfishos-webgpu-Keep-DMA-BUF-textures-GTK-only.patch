 };
 
-#if defined(XP_LINUX) && !defined(MOZ_WIDGET_ANDROID)
+#ifdef MOZ_WIDGET_GTK
 class VkImageHandle {
  public:
   explicit VkImageHandle(WebGPUParent* aParent,
diff --git a/dom/webgpu/moz.build b/dom/webgpu/moz.build
index 9c05835bc8d9..0ce569e07333 100644
--- a/dom/webgpu/moz.build
+++ b/dom/webgpu/moz.build
@@ -84,7 +84,7 @@ if CONFIG["MOZ_WIDGET_TOOLKIT"] == "windows":
         "SharedTextureD3D11.cpp",
     ]
 
-if CONFIG["OS_TARGET"] == "Linux":
+if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
