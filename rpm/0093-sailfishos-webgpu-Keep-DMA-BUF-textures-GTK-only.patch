From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Branson <andrew.branson@jolla.com>
Date: Thu, 6 Aug 2026 15:59:43 +0200
Subject: [sailfishos][webgpu] Keep DMA-BUF textures GTK-only

The DMA-BUF external texture implementation depends on widget/gtk exports.
Do not build or reference it with the Qt widget backend, and select the
existing readback presentation path instead.

Co-authored-by: Sebastian Matkovich <38816871+smatkovi@users.noreply.github.com>
---
 dom/webgpu/CanvasContext.cpp                  | 5 ++++-
 dom/webgpu/SharedTexture.cpp                  | 4 ++--
 dom/webgpu/ipc/WebGPUParent.cpp               | 8 ++++----
 dom/webgpu/ipc/WebGPUParent.h                 | 2 +-
 dom/webgpu/moz.build                          | 2 +-
 gfx/wgpu_bindings/Cargo.toml                  | 1 +
 gfx/wgpu_bindings/src/server.rs               | 8 ++++----
 toolkit/library/rust/gkrust-features.mozbuild | 3 +++
 toolkit/library/rust/shared/Cargo.toml        | 1 +
 9 files changed, 21 insertions(+), 13 deletions(-)

diff --git a/dom/webgpu/CanvasContext.cpp b/dom/webgpu/CanvasContext.cpp
index e3f2a2636b28..39458c6f0e50 100644
--- a/dom/webgpu/CanvasContext.cpp
+++ b/dom/webgpu/CanvasContext.cpp
@@ -142,7 +142,7 @@ void CanvasContext::Configure(const dom::GPUCanvasConfiguration& aConfig,
                        "WebRender is not using hardware acceleration";
     mUseSharedTextureInSwapChain = false;
   }
-#elif defined(XP_LINUX) && !defined(MOZ_WIDGET_ANDROID)
+#elif defined(MOZ_WIDGET_GTK)
   // When DMABufDevice is not enabled, disable shared texture in swap chain.
   const auto& modifiers = gfx::gfxVars::DMABufModifiersARGB();
   if (modifiers.IsEmpty()) {
@@ -150,6 +150,9 @@ void CanvasContext::Configure(const dom::GPUCanvasConfiguration& aConfig,
                        "missing GBM_FORMAT_ARGB8888 dmabuf format";
     mUseSharedTextureInSwapChain = false;
   }
+#elif defined(XP_LINUX) && !defined(MOZ_WIDGET_ANDROID)
+  // Other Linux widget toolkits do not build the GTK DMA-BUF backend.
+  mUseSharedTextureInSwapChain = false;
 #endif
 
   mCurrentTexture = aConfig.mDevice->InitSwapChain(
diff --git a/dom/webgpu/SharedTexture.cpp b/dom/webgpu/SharedTexture.cpp
index 713308a31da5..2b697cf8a8d6 100644
--- a/dom/webgpu/SharedTexture.cpp
+++ b/dom/webgpu/SharedTexture.cpp
@@ -10,7 +10,7 @@
