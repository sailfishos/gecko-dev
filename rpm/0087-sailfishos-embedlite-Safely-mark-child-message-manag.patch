From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Branson <andrew.branson@jolla.com>
Date: Thu, 27 Aug 2026 17:14:02 +0200
Subject: [sailfishos][embedlite] Safely mark child message managers

MarkChildMessageManagers assumed every leaf callback was an nsFrameLoader,
but EmbedLite uses BrowserChildHelperChromeMessageManagerCallback. Add a
virtual marking hook so callbacks can preserve their own marking behavior
without an invalid downcast.
---
 dom/base/MessageManagerCallback.h    |  2 ++
 dom/base/nsCCUncollectableMarker.cpp | 16 +---------------
 dom/base/nsFrameLoader.cpp           | 15 +++++++++++++++
 dom/base/nsFrameLoader.h             |  1 +
 4 files changed, 19 insertions(+), 15 deletions(-)

diff --git a/dom/base/MessageManagerCallback.h b/dom/base/MessageManagerCallback.h
index d8986740c8aa..25412ccc35ed 100644
--- a/dom/base/MessageManagerCallback.h
+++ b/dom/base/MessageManagerCallback.h
@@ -61,6 +61,8 @@ class MessageManagerCallback {
 
   virtual void DoGetRemoteType(nsACString& aRemoteType,
                                ErrorResult& aError) const;
+
+  virtual void MarkChildMessageManagerForCC() {}
 };
 
 }  // namespace ipc
diff --git a/dom/base/nsCCUncollectableMarker.cpp b/dom/base/nsCCUncollectableMarker.cpp
index f896d0a7da39..7a5d3a320291 100644
--- a/dom/base/nsCCUncollectableMarker.cpp
+++ b/dom/base/nsCCUncollectableMarker.cpp
@@ -4,7 +4,6 @@
 
 #include "nsCCUncollectableMarker.h"
 
-#include "InProcessBrowserChildMessageManager.h"
 #include "mozilla/CycleCollectedJSContext.h"
 #include "mozilla/CycleCollectedJSRuntime.h"
 #include "mozilla/EventListenerManager.h"
@@ -23,7 +22,6 @@
 #include "nsAppShellCID.h"
 #include "nsContentUtils.h"
 #include "nsFocusManager.h"
-#include "nsFrameLoader.h"
 #include "nsGlobalWindowInner.h"
 #include "nsGlobalWindowOuter.h"
 #include "nsIAppShellService.h"
@@ -108,21 +106,9 @@ static void MarkChildMessageManagers(MessageBroadcaster* aMM) {
 
     tabMM->MarkForCC();
 
-    // XXX hack warning, but works, since we know that
-    //    callback is frameloader.
     mozilla::dom::ipc::MessageManagerCallback* cb = tabMM->GetCallback();
     if (cb) {
-      nsFrameLoader* fl = static_cast<nsFrameLoader*>(cb);
-      InProcessBrowserChildMessageManager* et =
-          fl->GetBrowserChildMessageManager();
-      if (!et) {
-        continue;
-      }
-      et->MarkForCC();
-      EventListenerManager* elm = et->GetExistingListenerManager();
-      if (elm) {
-        elm->MarkForCC();
-      }
+      cb->MarkChildMessageManagerForCC();
     }
   }
 }
diff --git a/dom/base/nsFrameLoader.cpp b/dom/base/nsFrameLoader.cpp
index 1fa7822fe6e1..a9e7a10513b1 100644
--- a/dom/base/nsFrameLoader.cpp
+++ b/dom/base/nsFrameLoader.cpp
@@ -20,6 +20,7 @@
 #include "mozilla/BasePrincipal.h"
 #include "mozilla/ContentPrincipal.h"
 #include "mozilla/ExpandedPrincipal.h"
+#include "mozilla/EventListenerManager.h"
 #include "mozilla/FlushType.h"
 #include "mozilla/HTMLEditor.h"
 #include "mozilla/NullPrincipal.h"
@@ -2893,6 +2894,20 @@ nsresult nsFrameLoader::FinishStaticClone(
   return NS_OK;
 }
 
+void nsFrameLoader::MarkChildMessageManagerForCC() {
+  InProcessBrowserChildMessageManager* browserChild =
+      GetBrowserChildMessageManager();
+  if (!browserChild) {
+    return;
+  }
+
+  browserChild->MarkForCC();
+  EventListenerManager* elm = browserChild->GetExistingListenerManager();
+  if (elm) {
+    elm->MarkForCC();
+  }
+}
+
 bool nsFrameLoader::DoLoadMessageManagerScript(const nsAString& aURL,
                                                bool aRunInGlobalScope) {
   if (auto* browserParent = GetBrowserParent()) {
diff --git a/dom/base/nsFrameLoader.h b/dom/base/nsFrameLoader.h
index 173c8c0c82fc..ef95b0f74af3 100644
--- a/dom/base/nsFrameLoader.h
+++ b/dom/base/nsFrameLoader.h
@@ -148,6 +148,7 @@ class nsFrameLoader final : public nsStubMutationObserver,
   GetBrowserChildMessageManager() const {
     return mChildMessageManager;
   }
+  void MarkChildMessageManagerForCC() override;
   nsresult UpdatePositionAndSize(nsSubDocumentFrame* aFrame);
   void PropagateIsUnderHiddenEmbedderElement(
       bool aIsUnderHiddenEmbedderElement);
