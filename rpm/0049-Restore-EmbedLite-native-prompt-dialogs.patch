From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Branson <andrew.branson@jolla.com>
Date: Wed, 5 Aug 2026 17:35:32 +0200
Subject: Restore EmbedLite native prompt dialogs

Route alert, confirm, and text prompts through the EmbedLite application
service before falling back to ESR140's prompt actors or window dialogs.

Use the same Promise for synchronous and asynchronous callers so async prompt
APIs do not enter a nested event loop. Validate the target window on every
response and always unwind listener and modal-window state.

HTTP authentication remains with LoginManagerPrompter, which already owns the
asynchronous EmbedLite authentication bridge.
---
 .../components/prompts/src/Prompter.sys.mjs   | 210 ++++++++++++++++++
 1 file changed, 210 insertions(+)

diff --git a/toolkit/components/prompts/src/Prompter.sys.mjs b/toolkit/components/prompts/src/Prompter.sys.mjs
index f196f5ee1f57..46823fd129d0 100644
--- a/toolkit/components/prompts/src/Prompter.sys.mjs
+++ b/toolkit/components/prompts/src/Prompter.sys.mjs
@@ -1021,6 +1021,211 @@ class ModalPrompter {
 
   /* ---------- internal methods ---------- */
 
+  openEmbedLitePrompt(args) {
+    if (!this.browsingContext) {
+      return null;
+    }
+
+    let topic;
+    let responseTopic;
+    switch (args.promptType) {
+      case "alert":
+      case "alertCheck":
+        topic = "embed:alert";
+        responseTopic = "alertresponse";
+        break;
+      case "confirm":
+      case "confirmCheck":
+        topic = "embed:confirm";
+        responseTopic = "confirmresponse";
+        break;
+      case "prompt":
+        topic = "embed:prompt";
+        responseTopic = "promptresponse";
+        break;
+      default:
+        return null;
+    }
+
+    let embedService;
+    try {
+      embedService = Cc["@mozilla.org/embedlite-app-service;1"].getService(
+        Ci.nsIEmbedAppService
+      );
+    } catch (_) {
+      return null;
+    }
+
+    let embedWindow;
+    try {
+      embedWindow =
+        this.browsingContext.top?.window || this.browsingContext.window;
+    } catch (_) {
+      return null;
+    }
+    if (!embedWindow) {
+      return null;
+    }
+
+    let winId;
+    try {
+      winId = embedService.getIDByWindow(embedWindow);
+    } catch (_) {
+      return null;
+    }
+    if (!winId) {
+      return null;
+    }
+
+    let payload = {
+      winId,
+      title: args.title,
+      text: args.text,
+      inputs: [],
+    };
+    let buttons = [
+      args.button0Label,
+      args.button1Label,
+      args.button2Label,
+    ].filter(Boolean);
+    if (buttons.length) {
+      payload.buttons = buttons;
+    }
+
+    if (args.promptType == "prompt") {
+      payload.defaultValue = args.value || "";
+      payload.inputs.push({ value: args.value || "" });
+    }
+    if (args.checkLabel) {
+      payload.inputs.push({
+        label: args.checkLabel,
+        hint: "preventAddionalDialog",
+        checked: !!args.checked,
+      });
+    }
+
+    let listenerRegistered = false;
+    let enteredModalState = false;
+    let firedDialogEvent = false;
+    let promptWindow;
+    let windowUtils;
+    let listener;
+
+    let cleanup = () => {
+      if (listenerRegistered) {
+        try {
+          embedService.removeMessageListener(responseTopic, listener);
+        } catch (e) {
+          console.warn("EmbedLite prompt listener cleanup failed: ", e);
+        }
+        listenerRegistered = false;
+      }
+      try {
+        if (enteredModalState) {
+          windowUtils.leaveModalState();
+          enteredModalState = false;
+        }
+        if (firedDialogEvent) {
+          PromptUtils.fireDialogEvent(
+            promptWindow,
+            "DOMModalDialogClosed"
+          );
+          firedDialogEvent = false;
+        }
+      } catch (e) {
+        console.warn("EmbedLite prompt modal cleanup failed: ", e);
+      }
+    };
+
+    let resolvePrompt;
+    let result = new Promise(resolve => {
+      resolvePrompt = resolve;
+    });
+    let closed = false;
+    listener = {
+      QueryInterface: ChromeUtils.generateQI(["nsIEmbedMessageListener"]),
+
+      onMessageReceived(messageName, message) {
+        if (closed) {
+          return;
+        }
+
+        let response;
+        try {
+          response = JSON.parse(message);
+        } catch (e) {
+          console.warn("EmbedLite prompt response parsing failed: ", e);
+          return;
+        }
+        if (
+          !response ||
+          typeof response != "object" ||
+          response.winId !== winId
+        ) {
+          return;
+        }
+
+        if ("checkvalue" in response) {
+          args.checked = !!response.checkvalue;
+        }
+        if ("accepted" in response) {
+          args.ok = !!response.accepted;
+          args.buttonNumClicked = response.accepted ? 0 : 1;
+        }
+        if ("promptvalue" in response) {
+          args.value = response.promptvalue;
+        }
+
+        closed = true;
+        cleanup();
+        resolvePrompt(args);
+      },
+    };
+
+    const IS_CONTENT =
+      Services.appinfo.processType == Services.appinfo.PROCESS_TYPE_CONTENT;
+    if (IS_CONTENT) {
+      try {
+        promptWindow = this.browsingContext.window;
+        let docShell = this.browsingContext.docShell;
+        let inPermitUnload = docShell?.docViewer?.inPermitUnload;
+        args.inPermitUnload = inPermitUnload;
+        PromptUtils.fireDialogEvent(
+          promptWindow,
+          "DOMWillOpenModalDialog",
+          null,
+          Cu.cloneInto(
+            {
+              tabPrompt: this.modalType != MODAL_TYPE_WINDOW,
+              inPermitUnload,
+            },
+            promptWindow
+          )
+        );
+        firedDialogEvent = true;
+        windowUtils = promptWindow.windowUtils;
+        if (windowUtils) {
+          windowUtils.enterModalState();
+          enteredModalState = true;
+        }
+      } catch (e) {
+        console.warn("EmbedLite prompt modal setup failed: ", e);
+      }
+    }
+
+    try {
+      embedService.addMessageListener(responseTopic, listener);
+      listenerRegistered = true;
+      embedService.sendAsyncMessage(winId, topic, JSON.stringify(payload));
+    } catch (e) {
+      cleanup();
+      console.warn("EmbedLite prompt dispatch failed: ", e);
+      return null;
+    }
+
+    return result;
+  }
+
   /**
    * Synchronous wrapper around {@link ModalPrompter#openPrompt}
    *
@@ -1046,6 +1251,11 @@ class ModalPrompter {
   }
 
   async openPrompt(args) {
+    let embedLitePrompt = this.openEmbedLitePrompt(args);
+    if (embedLitePrompt) {
+      return embedLitePrompt;
+    }
+
     if (!this.browsingContext) {
       // We don't have a browsing context, fallback to a window prompt.
       args.modalType = MODAL_TYPE_WINDOW;
