From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mike Hommey <mh@glandium.org>
Date: Mon, 28 Nov 2022 22:39:50 +0000
Subject: [PATCH 65/67] Bug 1773259 - Work around build failure with newer
 cbindgen. r=ahochheiden, a=RyanVM

Differential Revision: https://phabricator.services.mozilla.com/D162262
---
 build/moz.configure/bindgen.configure  | 24 ++++++++++++++++++++++++
 config/makefiles/rust.mk               |  4 ++++
 gfx/webrender_bindings/webrender_ffi.h |  4 ++++
 3 files changed, 32 insertions(+)

diff --git a/build/moz.configure/bindgen.configure b/build/moz.configure/bindgen.configure
index 5ce66fe9afe9..e10f1d5d6930 100644
--- a/build/moz.configure/bindgen.configure
+++ b/build/moz.configure/bindgen.configure
@@ -91,6 +91,15 @@ def cbindgen(cbindgen_override, bootstrap_search_path, rust_search_path):
 
 set_config("CBINDGEN", cbindgen)
 
+set_define(
+    "CBINDGEN_0_24",
+    True,
+    when=depends_if(cbindgen)(
+        lambda c: Version(check_cmd_output(c, "--version").strip().split(" ")[1])
+        >= "0.24.0"
+    ),
+)
+
 # Bindgen can use rustfmt to format Rust file, but it's not required.
 option(env="RUSTFMT", nargs=1, help="Path to the rustfmt program")
 
@@ -108,6 +117,11 @@ option(
     nargs=1,
     help="Absolute path to a directory containing Clang/LLVM libraries for bindgen (version 3.9.x or above)",
 )
+option(
+    env="MOZ_LIBCLANG_BINDGEN_PATH",
+    nargs=1,
+    help="Absolute path to the libclang directory that Rust bindgen build scripts should load",
+)
 option(
     "--with-clang-path",
     nargs=1,
@@ -326,6 +340,16 @@ set_config("MOZ_LIBCLANG_PATH", bindgen_config_paths.libclang_path)
 set_config("MOZ_CLANG_PATH", bindgen_config_paths.clang_path)
 
 
+@depends("MOZ_LIBCLANG_BINDGEN_PATH", bindgen_config_paths.libclang_path)
+def bindgen_runtime_libclang_path(path, default):
+    if path:
+        return path[0]
+    return default
+
+
+set_config("MOZ_LIBCLANG_BINDGEN_PATH", bindgen_runtime_libclang_path)
+
+
 @depends(
     target,
     target_is_unix,
diff --git a/config/makefiles/rust.mk b/config/makefiles/rust.mk
index 894e2b341a53..74d14bb46df4 100644
--- a/config/makefiles/rust.mk
+++ b/config/makefiles/rust.mk
@@ -221,7 +221,11 @@ export RUSTFLAGS
 export RUSTC
 export RUSTDOC
 export RUSTFMT
+ifdef MOZ_LIBCLANG_BINDGEN_PATH
+export LIBCLANG_PATH=$(MOZ_LIBCLANG_BINDGEN_PATH)
+else
 export LIBCLANG_PATH=$(MOZ_LIBCLANG_PATH)
+endif
 export CLANG_PATH=$(MOZ_CLANG_PATH)
 export PKG_CONFIG
 export PKG_CONFIG_ALLOW_CROSS=1
diff --git a/gfx/webrender_bindings/webrender_ffi.h b/gfx/webrender_bindings/webrender_ffi.h
index e9c8be1ef41c..35194ff37bd1 100644
--- a/gfx/webrender_bindings/webrender_ffi.h
+++ b/gfx/webrender_bindings/webrender_ffi.h
@@ -73,6 +73,10 @@ struct WrPipelineInfo;
 struct WrPipelineIdAndEpoch;
 using WrPipelineIdEpochs = nsTArray<WrPipelineIdAndEpoch>;
 
+#ifndef CBINDGEN_0_24
+const uint64_t ROOT_CLIP_CHAIN = ~0;
+#endif
+
 }  // namespace wr
 }  // namespace mozilla
 
