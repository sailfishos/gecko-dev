From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Branson <andrew.branson@jolla.com>
Date: Sat, 16 May 2026 10:20:00 +0200
Subject: [PATCH 75/75] Load EmbedLite search engines from settings

EmbedLite ships search engine definitions as normal profile search settings,
without Firefox's WebExtension based search engine packages.  The ESR115
SearchService waits for AddonManager startup before loading engines from the
selector, which leaves EmbedLite address-bar searches without engines.

For the EmbedLite application ID, load engines directly from the persisted
settings data and tolerate the lack of a WebExtension default engine entry.
---
 .../components/search/SearchService.sys.mjs   | 23 +++++++++++++++----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/toolkit/components/search/SearchService.sys.mjs b/toolkit/components/search/SearchService.sys.mjs
index afd0fff703f8..2a9ed9a8f1ca 100644
--- a/toolkit/components/search/SearchService.sys.mjs
+++ b/toolkit/components/search/SearchService.sys.mjs
@@ -1507,11 +1507,13 @@ export class SearchService {
    *   The engine that is default.
    */
   #appDefaultEngine(privateMode = false) {
-    let defaultEngine = this.#getEngineByWebExtensionDetails(
+    let defaultDetails =
       privateMode && this.#searchPrivateDefault
         ? this.#searchPrivateDefault
-        : this._searchDefault
-    );
+        : this._searchDefault;
+    let defaultEngine = defaultDetails
+      ? this.#getEngineByWebExtensionDetails(defaultDetails)
+      : null;
 
     if (Services.policies?.status == Ci.nsIEnterprisePolicies.ACTIVE) {
       let activePolicies = Services.policies.getActivePolicies();
@@ -1519,7 +1521,10 @@ export class SearchService {
         if (activePolicies.SearchEngines.Default) {
           return this.#getEngineByName(activePolicies.SearchEngines.Default);
         }
-        if (activePolicies.SearchEngines.Remove?.includes(defaultEngine.name)) {
+        if (
+          defaultEngine &&
+          activePolicies.SearchEngines.Remove?.includes(defaultEngine.name)
+        ) {
           defaultEngine = null;
         }
       }
@@ -1551,13 +1556,21 @@ export class SearchService {
    *   An object representing the search engine settings.
    */
   async #loadEngines(settings) {
+    lazy.logConsole.debug("#loadEngines: start");
+    if (Services.appinfo.ID === "embedliteBrowser@embed.mozilla.org") {
+      this.#loadEnginesFromSettings(settings?.engines);
+      this._settings.migrateEngineIds(settings || {});
+      this.#loadEnginesMetadataFromSettings(settings?.engines);
+      lazy.logConsole.debug("#loadEngines: done");
+      return;
+    }
+
     // Get user's current settings and search engine before we load engines from
     // config. These values will be compared after engines are loaded.
     let prevMetaData = { ...settings?.metaData };
     let prevCurrentEngineId = prevMetaData.defaultEngineId;
     let prevAppDefaultEngineId = prevMetaData?.appDefaultEngineId;
 
-    lazy.logConsole.debug("#loadEngines: start");
     let { engines, privateDefault } = await this._fetchEngineSelectorEngines();
     this.#setDefaultAndOrdersFromSelector(engines, privateDefault);
 
