+int32_t DeviceInfoSFOS::Init()
+{
+    cameraManager = gecko_camera_manager();
+    // Initialize parent class member
+    _lastUsedDeviceName = (char *)malloc(1);
+    _lastUsedDeviceName[0] = 0;
+    return 0;
