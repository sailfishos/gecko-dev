+struct PackedI420Layout {
+  int width;
+  int height;
+  int strideY;
+  int strideUV;
+  size_t sizeY;
+  size_t sizeU;
+  size_t sizeV;
+
+  size_t TotalSize() const { return sizeY + sizeU + sizeV; }
