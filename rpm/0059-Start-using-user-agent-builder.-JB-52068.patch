From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Raine Makelainen <raine.makelainen@jolla.com>
Date: Fri, 4 Dec 2020 16:56:05 +0200
Subject: [PATCH 59/67] Start using user-agent builder. JB#52068

Signed-off-by: Raine Makelainen <raine.makelainen@jolla.com>
---
 netwerk/protocol/http/nsHttpHandler.cpp | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/netwerk/protocol/http/nsHttpHandler.cpp b/netwerk/protocol/http/nsHttpHandler.cpp
index 3fc3b7fa1b98..d239f501dbd2 100644
--- a/netwerk/protocol/http/nsHttpHandler.cpp
+++ b/netwerk/protocol/http/nsHttpHandler.cpp
@@ -436,7 +436,9 @@ nsresult nsHttpHandler::Init() {
 
   mRequestContextService = RequestContextService::GetOrCreate();
 
-#if defined(ANDROID)
+#if defined(MOZ_EMBEDLITE)
+  mProductSub.AssignLiteral(MOZILLA_UAVERSION);
+#elif defined(ANDROID)
   mProductSub.Assign(uaVersion);
 #else
   mProductSub.AssignLiteral(LEGACY_UA_GECKO_TRAIL);
@@ -871,7 +873,7 @@ void nsHttpHandler::InitUserAgentComponents() {
   }
 #endif
 
-#ifdef ANDROID
+#if defined(ANDROID) || defined(MOZ_EMBEDLITE)
   nsCOMPtr<nsIPropertyBag2> infoService =
       do_GetService("@mozilla.org/system-info;1");
   MOZ_ASSERT(infoService, "Could not find a system info service");
@@ -900,10 +902,12 @@ void nsHttpHandler::InitUserAgentComponents() {
     mCompatDevice.AssignLiteral("Mobile");
   }
 
+#if defined(MOZ_WIDGET_ANDROID)
   if (Preferences::GetBool(UA_PREF("use_device"), false)) {
     mDeviceModelId = mozilla::net::GetDeviceModelId();
   }
-#endif  // ANDROID
+#endif  // MOZ_WIDGET_ANDROID
+#endif  // ANDROID || MOZ_EMBEDLITE
 
   // Gather OS/CPU.
 #if defined(XP_WIN)
-- 
2.51.0

