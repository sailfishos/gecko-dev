From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Branson <andrew.branson@jolla.com>
Date: Mon, 11 May 2026 18:10:00 +0200
Subject: [PATCH 71/71] Allow disabling default protocol handler injection

EmbedLite delegates external protocols to the platform through content-action.
Firefox's built-in web mailto handlers create stub entries in handlers.json;
on Sailfish those stubs can divert mailto: away from the platform handler path
and leave the embedder without a usable chooser.

Add a pref-gated opt-out that skips default handler injection and removes
previously injected stub entries. Real user-selected handlers are left alone.
---
 .../exthandler/ExtHandlerService.sys.mjs      | 24 +++++++++++++
 .../unit/test_defaults_handlerService.js      | 36 +++++++++++++++++++
 2 files changed, 60 insertions(+)

diff --git a/uriloader/exthandler/ExtHandlerService.sys.mjs b/uriloader/exthandler/ExtHandlerService.sys.mjs
index 47e942f6791bb..54c3736391450 100644
--- a/uriloader/exthandler/ExtHandlerService.sys.mjs
+++ b/uriloader/exthandler/ExtHandlerService.sys.mjs
@@ -97,6 +97,16 @@ HandlerService.prototype = {
    */
   _injectDefaultProtocolHandlersIfNeeded() {
     try {
+      if (
+        Services.prefs.getBoolPref(
+          "gecko.handlerService.disableDefaultProtocolHandlers",
+          false
+        )
+      ) {
+        this._removeDefaultProtocolHandlerStubs();
+        return;
+      }
+
       let defaultHandlersVersion = Services.prefs.getIntPref(
         "gecko.handlerService.defaultHandlersVersion",
         0
@@ -115,6 +125,20 @@ HandlerService.prototype = {
     }
   },
 
+  _removeDefaultProtocolHandlerStubs() {
+    let changed = false;
+    for (let scheme of Object.keys(lazy.kHandlerList.default.schemes)) {
+      let existingSchemeInfo = this._store.data.schemes[scheme];
+      if (existingSchemeInfo && existingSchemeInfo.stubEntry) {
+        delete this._store.data.schemes[scheme];
+        changed = true;
+      }
+    }
+    if (changed) {
+      this._store.saveSoon();
+    }
+  },
+
   _injectDefaultProtocolHandlers() {
     let locale = Services.locale.appLocaleAsBCP47;
 
diff --git a/uriloader/exthandler/tests/unit/test_defaults_handlerService.js b/uriloader/exthandler/tests/unit/test_defaults_handlerService.js
index 72d3779fd8827..e23124ea44a4b 100644
--- a/uriloader/exthandler/tests/unit/test_defaults_handlerService.js
+++ b/uriloader/exthandler/tests/unit/test_defaults_handlerService.js
@@ -63,6 +63,42 @@ add_task(async function test_check_defaults_get_added() {
   }
 });
 
+add_task(async function test_disable_default_protocol_handlers() {
+  const pref = "gecko.handlerService.disableDefaultProtocolHandlers";
+  let handlerService = gHandlerService.wrappedJSObject;
+  let schemes = handlerService._store.data.schemes;
+
+  try {
+    Services.prefs.setBoolPref(pref, true);
+
+    schemes.mailto = {
+      stubEntry: true,
+      handlers: [null],
+    };
+    handlerService._injectDefaultProtocolHandlersIfNeeded();
+    Assert.ok(
+      !("mailto" in schemes),
+      "Previously injected stub handlers should be removed"
+    );
+
+    let userEntry = {
+      stubEntry: false,
+      handlers: [null],
+      alwaysAskBeforeHandling: false,
+    };
+    schemes.mailto = userEntry;
+    handlerService._injectDefaultProtocolHandlersIfNeeded();
+    Assert.strictEqual(
+      schemes.mailto,
+      userEntry,
+      "User-managed protocol handlers should be preserved"
+    );
+  } finally {
+    Services.prefs.clearUserPref(pref);
+    await deleteHandlerStore();
+  }
+});
+
 add_task(async function test_check_default_modification() {
   Assert.ok(
     true,
