--- /dev/null
+++ b/build/autoconf/pkg.m4
@@ -0,0 +1,39 @@
+dnl Minimal pkg-config macros for old-configure.in.
+dnl
+dnl ESR115 has moved most pkg-config checks to moz.configure, but the
+dnl Sailfish Qt, dconf, content-action and geckocamera restoration still uses
+dnl old-configure.in.  The usual pkg.m4 from pkg-config is for newer autoconf
+dnl and expands macros that autoconf 2.13 does not provide, so keep this small.
+
+AC_DEFUN([PKG_PROG_PKG_CONFIG],
+[AC_PATH_PROG(PKG_CONFIG, pkg-config, no)
+if test "$PKG_CONFIG" = no; then
+    PKG_CONFIG=
+fi
+])
+
+dnl PKG_CHECK_MODULES(VARIABLE-PREFIX, MODULES,
+dnl                   [ACTION-IF-FOUND], [ACTION-IF-NOT-FOUND])
+AC_DEFUN([PKG_CHECK_MODULES],
+[AC_REQUIRE([PKG_PROG_PKG_CONFIG])dnl
+pkg_failed=no
+AC_MSG_CHECKING([for $2])
+if test -n "$PKG_CONFIG" && $PKG_CONFIG --exists "$2"; then
+    $1[]_CFLAGS=`$PKG_CONFIG --cflags "$2"`
+    $1[]_LIBS="`$PKG_CONFIG --libs "$2" | sed s/-Wl,--export-dynamic//g`"
+    AC_MSG_RESULT([yes])
+    ifelse([$3], , :, [$3])
+else
+    $1[]_CFLAGS=
+    $1[]_LIBS=
+    if test -n "$PKG_CONFIG"; then
+        $1[]_PKG_ERRORS=`$PKG_CONFIG --errors-to-stdout --print-errors "$2"`
+    else
+        $1[]_PKG_ERRORS="pkg-config not found"
+    fi
+    AC_MSG_RESULT([no])
+    ifelse([$4], ,
+        [AC_MSG_ERROR([Library requirements ($2) not met; consider adjusting PKG_CONFIG_PATH])],
+        [$4])
+fi
+])
