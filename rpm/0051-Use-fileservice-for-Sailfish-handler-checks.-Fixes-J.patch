     // Skip the dialog if a preferred application is set and the caller has
     // permission.
     if (
@@ -262,6 +283,244 @@ export class nsContentDispatchChooser {
     return shouldOpenHandler;
   }
 
+  _shouldUseSailfishExternalAppPrompt(aHandler, aURI) {
+    return (
+      AppConstants.MOZ_WIDGET_TOOLKIT == "qt" &&
+      !E10SUtils.STANDARD_SAFE_PROTOCOLS.includes(aURI.scheme) &&
+      !aHandler.alwaysAskBeforeHandling &&
+      aHandler.preferredAction == Ci.nsIHandlerInfo.useSystemDefault
+    );
+  }
+
+  async _handleSailfishExternalApp(
+    aHandler,
+    aURI,
+    aPrincipal,
+    aBrowsingContext
+  ) {
+    if (!this._hasSailfishExternalAppPermission(aURI.scheme, aPrincipal)) {
+      let result;
+      try {
+        result = await this._openSailfishExternalAppPermissionPrompt(
+          aPrincipal,
+          aBrowsingContext,
+          aURI
+        );
+      } catch (error) {
+        console.error(error.message);
+        return false;
+      }
+
+      if (!result?.accepted) {
+        return false;
+      }
+
+      if (result.remember && !aBrowsingContext?.usePrivateBrowsing) {
+        this._updateSailfishExternalAppPermission(
+          aPrincipal,
+          aURI.scheme,
+          true
+        );
+      }
+    }
+
+    try {
+      aHandler.launchWithURI(aURI, aBrowsingContext);
+      return true;
+    } catch (error) {
+      console.error(error.message);
+      return false;
+    }
+  }
+
+  _hasSailfishExternalAppPermission(aScheme, aPrincipal) {
+    if (!aPrincipal || aPrincipal.isSystemPrincipal) {
+      return true;
+    }
+
+    if (!this._isSupportedPrincipal(aPrincipal)) {
+      return false;
+    }
+
+    let key = this._getSkipProtoDialogPermissionKey(aScheme);
+    return (
+      Services.perms.testPermissionFromPrincipal(aPrincipal, key) ===
+      Services.perms.ALLOW_ACTION
+    );
+  }
+
+  _updateSailfishExternalAppPermission(aPrincipal, aScheme, aAllow) {
+    if (
+      !aPrincipal ||
+      aPrincipal.isSystemPrincipal ||
+      !this._isSupportedPrincipal(aPrincipal)
+    ) {
+      return;
+    }
+
+    let principal = aPrincipal;
+    let addonPolicy = aPrincipal.contentScriptAddonPolicy;
+    if (addonPolicy) {
+      principal = Services.scriptSecurityManager.principalWithOA(
+        addonPolicy.extension.principal,
+        principal.originAttributes
+      );
+    }
+
+    let permKey = this._getSkipProtoDialogPermissionKey(aScheme);
+    if (aAllow) {
+      Services.perms.addFromPrincipal(
+        principal,
+        permKey,
+        Services.perms.ALLOW_ACTION,
+        Services.perms.EXPIRE_NEVER
+      );
+    } else {
+      Services.perms.removeFromPrincipal(principal, permKey);
+    }
+  }
+
+  _displayPrePath(aPrincipal) {
+    if (!aPrincipal) {
+      return null;
+    }
+
+    try {
+      if (aPrincipal.isNullPrincipal) {
+        return aPrincipal.precursorPrincipal?.exposablePrePath ?? null;
+      }
+      return aPrincipal.exposablePrePath;
+    } catch (error) {
+      console.error(error.message);
+      return null;
+    }
+  }
+
+  async _openSailfishExternalAppPermissionPrompt(
+    aPrincipal,
+    aBrowsingContext,
+    aURI
+  ) {
+    let embedService;
+    try {
+      embedService = Cc["@mozilla.org/embedlite-app-service;1"].getService(
+        Ci.nsIEmbedAppService
+      );
+    } catch (error) {
+      throw new Error("EmbedLite app service is not available.");
+    }
+
+    let win;
+    try {
+      win = aBrowsingContext?.top?.window || aBrowsingContext?.window;
+    } catch (error) {
+      win = null;
+    }
+    if (!win) {
+      try {
+        win = embedService.getAnyEmbedWindow(true);
+      } catch (error) {
+        win = null;
+      }
+    }
+    if (!win) {
+      throw new Error("External app permission prompt has no window.");
+    }
+
+    let winId = embedService.getIDByWindow(win);
+    if (!winId) {
+      throw new Error("External app permission prompt has no window id.");
+    }
+
+    let id = ++gSailfishExternalAppPromptId;
+    let payload = {
+      winId,
+      id,
+      host: this._displayPrePath(aPrincipal),
+      scheme: aURI.scheme,
+      url: this._displayURI(aURI),
+      privateBrowsing: !!aBrowsingContext?.usePrivateBrowsing,
+    };
+
+    return new Promise(resolve => {
+      let finished = false;
+      let timer = null;
+      let listener = {
+        QueryInterface: ChromeUtils.generateQI(["nsIEmbedMessageListener"]),
+
+        onMessageReceived(messageName, message) {
+          let response;
+          try {
+            response = JSON.parse(message);
+          } catch (error) {
+            console.warn("External app permission response parsing failed.");
+            return;
+          }
+
+          if (response.winId != winId || response.id != id) {
+            return;
+          }
+
+          finish({
+            accepted: !!response.accepted,
+            remember: !!response.remember,
+          });
+        },
+      };
+
+      let finish = result => {
+        if (finished) {
+          return;
+        }
+        finished = true;
+        if (timer) {
+          clearTimeout(timer);
+        }
+        embedService.removeMessageListener(
+          SAILFISH_EXTERNAL_APP_RESPONSE_TOPIC,
+          listener
+        );
+        resolve(result);
+      };
+
+      embedService.addMessageListener(
+        SAILFISH_EXTERNAL_APP_RESPONSE_TOPIC,
+        listener
+      );
+      timer = setTimeout(
+        () => finish({ accepted: false, remember: false }),
+        SAILFISH_EXTERNAL_APP_PROMPT_TIMEOUT_MS
+      );
+
+      try {
+        embedService.sendAsyncMessage(
+          winId,
+          SAILFISH_EXTERNAL_APP_PROMPT_TOPIC,
+          JSON.stringify(payload)
+        );
+      } catch (error) {
+        finish({ accepted: false, remember: false });
+      }
+    });
+  }
+
+  _displayURI(aURI) {
+    if (!aURI) {
+      return null;
+    }
+
+    try {
+      return aURI.displaySpec;
+    } catch (error) {
+      try {
+        return aURI.spec;
+      } catch (fallbackError) {
+        console.error(fallbackError.message);
+        return null;
+      }
+    }
+  }
+
   /**
    * Test if a given principal has the open-protocol-handler permission for a
    * specific protocol.
diff --git a/uriloader/exthandler/SailfishFileService.cpp b/uriloader/exthandler/SailfishFileService.cpp
new file mode 100644
index 0000000000000..115874f68d70a
--- /dev/null
+++ b/uriloader/exthandler/SailfishFileService.cpp
@@ -0,0 +1,57 @@
+/* -*- Mode: C++; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim:expandtab:shiftwidth=2:tabstop=2:cin:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "SailfishFileService.h"
+
+#include <QtDBus/QDBusConnection>
+#include <QtDBus/QDBusMessage>
+#include <QtCore/QVariant>
+#include <QtCore/QString>
+
+namespace {
+
+const char FileServiceName[] = "org.sailfishos.fileservice";
+const char FileServicePath[] = "/";
+const char FileServiceInterface[] = "org.sailfishos.fileservice";
+const int FileServiceTimeout = 35000;
+
+bool callSupportCheck(const char* method, const nsACString& value)
+{
+  if (value.IsEmpty()) {
+    return false;
+  }
+
+  QDBusMessage message = QDBusMessage::createMethodCall(
+      QLatin1String(FileServiceName), QLatin1String(FileServicePath),
+      QLatin1String(FileServiceInterface), QLatin1String(method));
+  message << QString::fromUtf8(value.BeginReading(), value.Length());
+
+  QDBusMessage reply =
+      QDBusConnection::sessionBus().call(message, QDBus::Block,
+                                         FileServiceTimeout);
+  if (reply.type() != QDBusMessage::ReplyMessage ||
+      reply.arguments().isEmpty()) {
+    return false;
+  }
+
+  return reply.arguments().first().toBool();
+}
+
+}  // namespace
+
+namespace SailfishFileService {
+
+bool CheckMimeSupported(const nsACString& aMimeType)
+{
+  return callSupportCheck("checkMimeSupported", aMimeType);
+}
+
+bool CheckUrlSupported(const nsACString& aUrl)
+{
+  return callSupportCheck("checkUrlSupported", aUrl);
+}
+
+}  // namespace SailfishFileService
